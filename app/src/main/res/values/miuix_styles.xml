<resources>
    <!-- Applied after fixed accent overlays to keep MIUIX surfaces stable. -->
    <style name="ThemeOverlay.LSPosed.Miuix.Neutral" parent="ThemeOverlay">
        <item name="android:windowBackground">@color/lsposed_miuix_background</item>
        <item name="android:colorBackground">@color/lsposed_miuix_background</item>
        <item name="colorSurface">@color/lsposed_miuix_surface</item>
        <item name="colorSurfaceVariant">@color/lsposed_miuix_surface_variant</item>
        <item name="colorSurfaceContainerLowest">@color/lsposed_miuix_surface</item>
        <item name="colorSurfaceContainerLow">@color/lsposed_miuix_surface</item>
        <item name="colorSurfaceContainer">@color/lsposed_miuix_surface_variant</item>
        <item name="colorSurfaceContainerHigh">@color/lsposed_miuix_surface_variant</item>
        <item name="colorSurfaceContainerHighest">@color/lsposed_miuix_surface_high</item>
        <item name="colorOnBackground">@color/lsposed_miuix_text_primary</item>
        <item name="colorOnSurface">@color/lsposed_miuix_text_primary</item>
        <item name="colorOnSurfaceVariant">@color/lsposed_miuix_text_secondary</item>
        <item name="colorOutline">@color/lsposed_miuix_outline</item>
        <item name="colorOutlineVariant">@color/lsposed_miuix_outline_variant</item>
    </style>

    <!-- Shape tokens shared by Views. They intentionally do not replace accent tokens. -->
    <style name="ShapeAppearance.LSPosed.Miuix.Small" parent="ShapeAppearance.Material3.Corner.None">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/lsposed_miuix_corner_small</item>
    </style>

    <style name="ShapeAppearance.LSPosed.Miuix.Medium" parent="ShapeAppearance.Material3.Corner.None">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/lsposed_miuix_corner_medium</item>
    </style>

    <style name="ShapeAppearance.LSPosed.Miuix.Large" parent="ShapeAppearance.Material3.Corner.None">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/lsposed_miuix_corner_large</item>
    </style>

    <style name="ShapeAppearance.LSPosed.Miuix.ModuleIcon" parent="ShapeAppearance.Material3.Corner.None">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">10dp</item>
    </style>

    <!-- MIUIX-like typography: restrained weights and no Material letter spacing. -->
    <style name="TextAppearance.LSPosed.Miuix.HeadlineLarge" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textSize">32sp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="TextAppearance.LSPosed.Miuix.TitleLarge" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textSize">22sp</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="TextAppearance.LSPosed.Miuix.TitleMedium" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textSize">17sp</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="TextAppearance.LSPosed.Miuix.BodyLarge" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textSize">16sp</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="TextAppearance.LSPosed.Miuix.BodyMedium" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
        <item name="android:textSize">14sp</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="TextAppearance.LSPosed.Miuix.PopupMenu" parent="TextAppearance.AppCompat.Widget.PopupMenu.Large">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="TextAppearance.LSPosed.Miuix.HomeInfoLabel" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textSize">17sp</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="TextAppearance.LSPosed.Miuix.HomeInfoValue" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
        <item name="android:textSize">14sp</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <!-- Reusable View widgets. List rows need explicit style references in layout XML. -->
    <style name="Widget.LSPosed.Miuix.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">?attr/colorSurface</item>
        <item name="cardCornerRadius">@dimen/lsposed_miuix_corner_medium</item>
        <item name="cardElevation">@dimen/lsposed_miuix_card_elevation</item>
        <item name="strokeColor">@color/lsposed_miuix_outline_variant</item>
        <item name="strokeWidth">@dimen/lsposed_miuix_card_stroke_width</item>
        <item name="shapeAppearance">@style/ShapeAppearance.LSPosed.Miuix.Medium</item>
    </style>

    <style name="Widget.LSPosed.Miuix.Card.Outlined" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">?attr/colorSurface</item>
        <item name="cardCornerRadius">@dimen/lsposed_miuix_corner_medium</item>
        <item name="cardElevation">@dimen/lsposed_miuix_card_elevation</item>
        <item name="strokeColor">@color/lsposed_miuix_outline_variant</item>
        <item name="strokeWidth">1dp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.LSPosed.Miuix.Medium</item>
    </style>

    <style name="Widget.LSPosed.Miuix.Toolbar" parent="Widget.MaterialComponents.Toolbar">
        <item name="android:background">@android:color/transparent</item>
        <item name="android:elevation">0dp</item>
        <item name="titleTextAppearance">@style/TextAppearance.LSPosed.Miuix.TitleLarge</item>
        <item name="subtitleTextAppearance">@style/TextAppearance.LSPosed.Miuix.BodyMedium</item>
    </style>

    <style name="Widget.LSPosed.Miuix.PopupMenu" parent="Widget.AppCompat.PopupMenu.Overflow">
        <item name="android:popupBackground">@drawable/miuix_popup_menu_background</item>
        <item name="android:dropDownVerticalOffset">4dp</item>
    </style>

    <!-- Long-press context menus (android:contextPopupMenuStyle) use the same
         MIUIX popup surface as toolbar overflow menus. -->
    <style name="Widget.LSPosed.Miuix.ContextPopupMenu" parent="Widget.AppCompat.PopupMenu">
        <item name="android:popupBackground">@drawable/miuix_popup_menu_background</item>
        <item name="android:dropDownVerticalOffset">4dp</item>
    </style>

    <!-- rikka SimpleMenuPreference (language / theme / update channel) renders
         its own MDC-1 style popup window. Parenting the library style keeps its
         list metrics (elevation, margins, units); only the background is
         swapped for the same MIUIX card used by overflow menus. -->
    <style name="Widget.LSPosed.Miuix.SimpleMenuPopup" parent="Widget.Preference.SimpleMenuPreference.PopupMenu">
        <item name="android:popupBackground">@drawable/miuix_popup_menu_background</item>
    </style>

    <style name="ThemeOverlay.LSPosed.Miuix.PopupMenu" parent="ThemeOverlay.MaterialComponents.ActionBar">
        <item name="actionOverflowMenuStyle">@style/Widget.LSPosed.Miuix.PopupMenu</item>
        <item name="popupMenuStyle">@style/Widget.LSPosed.Miuix.PopupMenu</item>
        <item name="dropdownListPreferredItemHeight">52dp</item>
        <item name="textAppearanceLargePopupMenu">@style/TextAppearance.LSPosed.Miuix.PopupMenu</item>
        <item name="textAppearanceSmallPopupMenu">@style/TextAppearance.LSPosed.Miuix.BodyMedium</item>
        <item name="android:colorBackground">?attr/colorSurface</item>
        <item name="android:textColorPrimary">?attr/colorOnSurface</item>
        <item name="colorControlNormal">?attr/colorOnSurfaceVariant</item>
        <!-- Selection state uses the same accent as switches and the
             navigation pill. A neutral surface here would render the checked
             row / check marks of SimpleMenuPreference and checkable menu
             items invisible on the white popup body. -->
        <item name="colorControlActivated">?attr/colorPrimary</item>
        <item name="android:colorAccent">?attr/colorPrimary</item>
        <item name="android:colorControlHighlight">@color/lsposed_miuix_outline_variant</item>
        <item name="colorControlHighlight">@color/lsposed_miuix_outline_variant</item>
    </style>

    <style name="ThemeOverlay.LSPosed.Miuix.ScopeSurface" parent="ThemeOverlay.MaterialComponents">
        <item name="android:colorBackground">?attr/colorSurface</item>
        <item name="android:textColorPrimary">?attr/colorOnSurface</item>
        <item name="android:textColorSecondary">?attr/colorOnSurfaceVariant</item>
        <item name="colorControlNormal">?attr/colorOnSurfaceVariant</item>
        <item name="colorControlActivated">?attr/colorPrimary</item>
    </style>

    <style name="Widget.LSPosed.Miuix.AppBar" parent="Widget.MaterialComponents.AppBarLayout.Primary">
        <item name="android:background">?android:attr/colorBackground</item>
        <item name="android:elevation">0dp</item>
        <item name="elevation">0dp</item>
    </style>

    <style name="Widget.LSPosed.Miuix.CollapsingToolbar" parent="Widget.Design.CollapsingToolbar">
        <item name="contentScrim">?android:attr/colorBackground</item>
        <item name="statusBarScrim">?android:attr/colorBackground</item>
        <item name="expandedTitleTextAppearance">@style/TextAppearance.LSPosed.Miuix.HeadlineLarge</item>
        <item name="collapsedTitleTextAppearance">@style/TextAppearance.LSPosed.Miuix.TitleLarge</item>
        <item name="expandedTitleMarginStart">@dimen/lsposed_miuix_title_horizontal</item>
        <item name="expandedTitleMarginEnd">@dimen/lsposed_miuix_title_horizontal</item>
    </style>

</resources>
