        <item name="statusAccent">?attr/colorOnPrimaryContainer</item>
        <item name="pageHorizontalPadding">16dp</item>
        <item name="listItemMarginVertical">6dp</item>
        <item name="homeInfoRowMinHeight">@dimen/theme_info_row_min_height</item>
        <item name="logTabContainerBackground">@drawable/m3e_log_tab_container</item>
        <item name="logTabItemBackground">@drawable/m3e_log_tab_item</item>
        <item name="logTabIndicatorColor">@android:color/transparent</item>
        <item name="logTabSelectedTextColor">?attr/colorOnSurface</item>
    </style>

    <style name="Theme.Light" parent="Base.AppTheme.Light" />

    <style name="Base.AppTheme" parent="Theme.Material3.DynamicColors.Dark.Rikka">
        <item name="themeCardColor">?attr/colorSurface</item>
        <item name="themePopupColor">?attr/colorSurface</item>
        <item name="themePopupBackground">@drawable/theme_popup_menu_background</item>
        <item name="themePopupTextAppearance">?attr/textAppearanceTitleMedium</item>
        <item name="themeNavigationColor">?attr/colorPageBackground</item>
