<resources>

    <style name="Base.AppTheme.Light" parent="Theme.Material3.DynamicColors.Light.Rikka">
        <item name="themeCardColor">?attr/colorSurface</item>
        <item name="themePopupColor">?attr/colorSurface</item>
        <item name="themePopupBackground">@drawable/theme_popup_menu_background</item>
        <item name="themePopupTextAppearance">?attr/textAppearanceTitleMedium</item>
        <item name="themeNavigationColor">?attr/colorPageBackground</item>
        <item name="themeNavigationSelectedColor">?attr/colorSecondaryContainer</item>
        <item name="themeNavigationOnSelectedColor">?attr/colorOnSecondaryContainer</item>
        <item name="themeChevronColor">?attr/colorOnSurfaceVariant</item>
        <item name="themePreferenceCategoryColor">?attr/colorOnSurfaceVariant</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="colorPrimaryVariant">@color/primary_dark_light_light_status_bar</item>

        <item name="android:statusBarColor">?android:colorBackground</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>

        <!-- Preference title -->
        <item name="android:textAppearanceListItem">?textAppearanceSubtitle1</item>
        <!-- Preference category title -->
        <item name="android:colorAccent">?colorPrimary</item>
        <!-- Preference switch -->
        <item name="android:colorControlActivated">?colorPrimary</item>

        <!-- Per-skin tokens; the Miuix/M3E overlays restyle all of them. -->
        <item name="colorPageBackground">?android:colorBackground</item>
        <item name="apiChipBackground">@drawable/m3e_api_chip_background</item>
        <item name="apiChipTextColor">?attr/colorOnSurfaceVariant</item>
        <item name="searchBarBackground">@drawable/m3e_search_background</item>
        <item name="statusContainer">?attr/colorPrimaryContainer</item>
