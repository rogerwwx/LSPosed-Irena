        <item name="colorSurfaceVariant">@color/lsposed_miuix_amoled_surface_variant</item>
        <item name="colorSurfaceContainerLowest">@color/lsposed_miuix_amoled_background</item>
        <item name="colorSurfaceContainerLow">@color/lsposed_miuix_amoled_surface</item>
        <item name="colorSurfaceContainer">@color/lsposed_miuix_amoled_surface</item>
        <item name="colorSurfaceContainerHigh">@color/lsposed_miuix_amoled_surface_variant</item>
        <item name="colorSurfaceContainerHighest">@color/lsposed_miuix_amoled_surface_variant</item>
