<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="?android:attr/colorControlHighlight">
    <!-- M3E master-switch bar: stays on the card surface like the reference
         (the lib default tints the whole bar with the primary container);
         the enabled state is conveyed by the switch itself. -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/colorSurfaceContainerLowest" />
            <corners android:radius="18dp" />
        </shape>
    </item>
</ripple>
