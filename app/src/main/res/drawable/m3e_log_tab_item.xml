<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- M3E segmented tab: selected = secondary container pill, unselected =
         white pill with a hairline outline, small gaps between the two. -->
    <item android:state_selected="true">
        <inset android:insetLeft="2dp" android:insetRight="2dp">
            <shape android:shape="rectangle">
                <solid android:color="?attr/colorSecondaryContainer" />
                <corners android:radius="28dp" />
            </shape>
        </inset>
    </item>
    <item>
        <inset android:insetLeft="2dp" android:insetRight="2dp">
            <shape android:shape="rectangle">
                <solid android:color="?attr/colorSurfaceContainerLowest" />
                <stroke android:width="1dp" android:color="?attr/colorOutlineVariant" />
                <corners android:radius="28dp" />
            </shape>
        </inset>
    </item>
</selector>
