<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/log_card"
    style="?attr/materialCardViewStyle"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="?attr/pageHorizontalPadding"
    android:layout_marginVertical="?attr/listItemMarginVertical"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/log_chips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/log_tag"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:ellipsize="marquee"
                android:fontFamily="monospace"
                android:textStyle="bold"
                android:maxLines="1"
                android:scrollbars="none"
                android:textColor="?attr/colorOnSurface"
                android:textSize="13sp"
                tools:text="BpBinder (0:3587)" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/log_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="12sp"
                tools:text="08-18 11:59:28" />
        </LinearLayout>

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/log_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="monospace"
            android:hyphenationFrequency="fullFast"
            android:textAlignment="viewStart"
            android:textColor="?attr/colorOnSurface"
            android:textSize="13sp"
            tools:text="Large outgoing transaction of 136 bytes, interface descriptor" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
